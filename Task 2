//Task 2: 
//Time complexity: O(n), space complexity: O(1)

class Solution {
public:
    void reverseString(vector<char>& s) {

        int left=0;
        int right=s.size()-1;

        while(left<right)
        {
            swap(s[left],s[right]);
            right--;
            left++;
        }


        
    }
};
