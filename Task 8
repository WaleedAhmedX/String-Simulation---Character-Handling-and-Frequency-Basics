//Task 8: 
//Time complexity: O(n^2), space complexity: O(n)

class Solution {
public:
    bool repeatedSubstringPattern(string s) {


        for(int len=1; len<s.size();len++)
        {

            if(s.size()%len==0)
            {

                string pattern=s.substr(0,len);

                bool value=true;

                for(int i=0;i<s.size();i++)
                {
                    if(s[i]!=pattern[i%len])
                    {
                        value=false;
                        break;
                    }
                }

                if(value)
                {
                    return true;
                }

            }
        }

        return false;
        
    }
};
