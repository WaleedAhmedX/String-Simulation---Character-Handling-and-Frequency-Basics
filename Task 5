//Task 5:
//Space complexity: O(1), Time complexity: O(n)

class Solution {
public:
    bool isAnagram(string s, string t) {

        int arr1[26]={};
        int arr2[26]={};

        for(int i=0;i<s.size();i++)
        {
            arr1[s[i]-'a']++;
        }

        for(int i=0;i<t.size();i++)
        {
            arr2[t[i]-'a']++;
        }
        
        for(int i=0;i<26;i++)
        {

            if(arr1[i]!=arr2[i])
            {
                return false;
            }

        }
        return true;

    }
};
