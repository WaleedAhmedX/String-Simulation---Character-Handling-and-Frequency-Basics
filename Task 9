//Task 9:
// Time complexity: O(n), Space complexity: O(1)

class Solution {
public:
    bool isIsomorphic(string s, string t) {

        int mapst[256]={};
        int mapts[256]={};

        for(int i=0;i<s.size();i++)
        {
            if(mapst[s[i]]!=0 && mapst[s[i]]!=t[i])
            {
                return false;
            }
            if(mapts[t[i]]!=0 && mapts[t[i]]!=s[i])
            {
                return false;
            }

            mapst[s[i]]=t[i];
            mapts[t[i]]=s[i];

        }

        return true;
        
    }
};
